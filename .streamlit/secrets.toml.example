# ── How to use this file ────────────────────────────────────────────────────
#
# LOCAL DEVELOPMENT (Streamlit):
#   cp .streamlit/secrets.toml.example .streamlit/secrets.toml
#   Fill in your values, then run:
#     streamlit run frontend/app.py
#
# STREAMLIT CLOUD:
#   Go to your app dashboard → Settings → Secrets and paste the keys below
#   (without the comments). Do NOT commit secrets.toml — it is git-ignored.
#
# ALTERNATIVE (local only):
#   Copy .env.example to .env and fill in values there instead.
#   pydantic-settings reads .env automatically.
# ────────────────────────────────────────────────────────────────────────────

# Required
ANTHROPIC_API_KEY = "sk-ant-..."

# Optional — leave empty to use the official Anthropic API endpoint
ANTHROPIC_BASE_URL = ""

# Optional — leave empty to skip database persistence
DATABASE_URL = ""

# Optional overrides (defaults shown)
OUTPUT_DIR = "data/outputs"
MAX_UPLOAD_SIZE_MB = "200"
SESSION_TTL_SECONDS = "1800"
ALLOWED_EXTENSIONS = "csv,xlsx,json,parquet"
